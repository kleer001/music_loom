node_modules/
.venv/
__pycache__/
*.pyc
tmp/
# Renders are scratch; the pantry's authored material is not. Without those
# files there is nothing for an instrument to draw on, and they are 8 MB of CC0
# source (PROVENANCE.md). The directories themselves stay unignored so the
# re-includes below can reach into them.
*.wav
!pantry/acoustic/loops/*.wav
!pantry/acoustic/strokes/*.wav
!pantry/machine/*.wav
*.webm
# Snapshots and console logs a browser driver leaves behind confirming a render.
.playwright-mcp/
.DS_Store
